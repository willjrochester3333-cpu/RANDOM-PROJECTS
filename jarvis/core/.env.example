# Shared by every node. setup.sh fills in a random password on first run.
MQTT_USER=jarvis
MQTT_PASSWORD=change-me

# Who answers questions. auto (default): Claude with live web search once ANTHROPIC_API_KEY is
# set, otherwise the local model. Or: claude, ollama (local model only), builtin.
# The time, date, our weather and forecast, dinner, devices and sums are always answered
# instantly by the house itself.
CHAT_BACKEND=auto

# ---- Internet answers: Claude with web search ----
# Your key from platform.claude.com (API keys). Easiest: run  bash set-key.sh  in this folder.
# Blank = the local model answers everything. Anthropic charges per question; see SETUP.md.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) is the most accurate. claude-haiku-5-5 is usually quicker and
# costs far less, but knows less.
ONLINE_MODEL=claude-opus-5-5
# How hard it thinks before answering: low (quickest), medium or high.
ONLINE_EFFORT=low
# 1 = fast mode (claude-opus-5-5 only): the answer arrives up to 2.5 times faster once it
# starts, at twice the price.
ONLINE_FAST_MODE=0
# Most web searches per question. Each costs 1 US cent, plus the pages it reads.
WEB_SEARCHES=2
# 1 = Claude runs a small program over the search results first and reads only what matters:
# cheaper on long searches, but one more step before it answers.
SEARCH_FILTERING=0

# ---- Local model (Ollama): answers when there is no key or no internet ----
# llama3.2:1b (default) answers 2 to 3 times faster than llama3.2:3b, which knows more but is
# slow on a Pi. Change it and run setup.sh again to download the new one.
OLLAMA_MODEL=llama3.2:1b
# Processor cores the model may use. 3 leaves one for the camera and speech; try 4 if you
# have no camera on this Pi.
OLLAMA_THREADS=3
# Longest answer, in tokens (about 3 words each). Answers that reach it end on a full sentence.
MAX_REPLY_TOKENS=400

# Your time zone and location, so it knows the date, time, sunrise and the forecast.
# Find the coordinates on openstreetmap.org (right-click, "Show address"). Leave blank for no forecast.
TZ=Europe/London
LOCATION_NAME=
LOCATION_LAT=
LOCATION_LON=
# Two-letter country code for local web results, e.g. GB. Blank = worked out from TZ.
LOCATION_COUNTRY=

# Microphone and speaker on this Pi. "default" is normally right once a USB device is plugged in;
# otherwise use a name from `arecord -L` / `aplay -L`, such as plughw:CARD=Device,DEV=0.
MIC_DEVICE=default
SPEAKER_DEVICE=default
# 1 = listen for "Hey Jarvis"; 0 = only the dashboard's Talk button starts listening.
WAKE_WORD=1
# Higher = fewer false wake-ups, lower = easier to trigger (0.3 to 0.8).
WAKE_THRESHOLD=0.5

# Seconds until a dinner call clears itself.
DINNER_TIMEOUT=180

# Settings-file version, used by setup.sh to upgrade older files once. Leave it alone.
JARVIS_ENV_VERSION=3
