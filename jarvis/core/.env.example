# Shared by every node. setup.sh fills in a random password on first run.
MQTT_USER=jarvis
MQTT_PASSWORD=change-me

# Who answers questions: ollama (local model, default), claude (needs the key below) or builtin.
CHAT_BACKEND=ollama
# Local model. llama3.2:3b (default) is the smartest that fits a Pi 5; llama3.2:1b answers
# 2 to 3 times faster and is the right choice on a 4 GB Pi. Change it and run setup.sh again.
OLLAMA_MODEL=llama3.2:3b

# Your time zone and location, so it knows the date, time, sunrise and the forecast.
# Find the coordinates on openstreetmap.org (right-click, "Show address"). Leave blank for no forecast.
TZ=Europe/London
LOCATION_NAME=
LOCATION_LAT=
LOCATION_LON=
# Only used when CHAT_BACKEND=claude.
ANTHROPIC_API_KEY=

# Microphone and speaker on this Pi. "default" is normally right once a USB device is plugged in;
# otherwise use a name from `arecord -L` / `aplay -L`, such as plughw:CARD=Device,DEV=0.
MIC_DEVICE=default
SPEAKER_DEVICE=default
# 1 = listen for "Hey Jarvis"; 0 = only the dashboard's Talk button starts listening.
WAKE_WORD=1
# Higher = fewer false wake-ups, lower = easier to trigger (0.3 to 0.8).
WAKE_THRESHOLD=0.5

# Seconds until a dinner call clears itself.
DINNER_TIMEOUT=180
